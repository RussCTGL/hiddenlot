# Defaults for the public deployment (Vercel). No secrets here: META_API_KEY
# and DATABASE_URL are set in the host's environment settings, which also
# override anything below. The Docker image does not read this file.

# Load the synthetic demo when the hosted database is empty.
HIDDENLOT_SEED_ON_START=true
# Visitors get neither Reset demo nor the demo clock.
HIDDENLOT_ALLOW_RESET=false
# Paid Meta calls per UTC day: all visitors together, and one visitor.
HIDDENLOT_META_DAILY_LIMIT=50
HIDDENLOT_META_VISITOR_LIMIT=10
# The simulated users take one market step per 60 minutes of use.
HIDDENLOT_MARKET_MINUTES=60
