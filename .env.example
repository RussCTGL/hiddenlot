# Copy to .env.local and fill in. Never commit real keys.
# Read only on the server (src/ai/meta/server.ts) and by scripts/meta-probe.ts.
# Do not prefix with NEXT_PUBLIC_ — that would ship the key to the browser.

META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Standard models only; *-contributor models are refused by the adapter.
META_MODEL=muse-spark-1.3
# Fallback candidate if 1.3 is unavailable on your account: muse-spark-1.2
META_TIMEOUT_MS=60000
# 0–2 bounded retries on 429/5xx/timeout. Invalid output is never retried.
META_MAX_RETRIES=2
